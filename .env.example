# Salin ke .env.local dan isi dari dashboard Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# RAHASIA — hanya server. Untuk manajemen user (buat/hapus akun) dari halaman /admin.
# Ambil dari Supabase: Project Settings > API > service_role (secret). JANGAN diawali NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Pengingat email/WhatsApp (opsional — fitur mati bila kosong) ===
# Alamat aplikasi (untuk tautan di pesan). Tanpa garis miring akhir.
NEXT_PUBLIC_SITE_URL=https://logbook-obgyn-usu.vercel.app

# Email — Resend (https://resend.com). FROM harus dari domain terverifikasi.
RESEND_API_KEY=re_xxx
RESEND_FROM=Logbook PPDS USU <noreply@domain-anda.com>

# WhatsApp — Fonnte (https://fonnte.com). Token perangkat WA.
FONNTE_TOKEN=xxxxxxxx

# Rahasia acak (buat sendiri, mis. `openssl rand -hex 24`).
# NOTIFY_WEBHOOK_SECRET dipakai header webhook Supabase → /api/notify/dispatch.
# CRON_SECRET dipakai Vercel Cron → /api/notify/cron.
NOTIFY_WEBHOOK_SECRET=ganti-dengan-acak
CRON_SECRET=ganti-dengan-acak

