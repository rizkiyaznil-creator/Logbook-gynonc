# Salin ke .env.local dan isi dari dashboard Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# RAHASIA — hanya server. Untuk manajemen user (buat/hapus akun) dari halaman /admin.
# Ambil dari Supabase: Project Settings > API > service_role (secret). JANGAN diawali NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
